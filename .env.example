# Copia este archivo como `.env` y completa OPENAI_API_KEY.
# docker compose lo lee automáticamente. NUNCA subas `.env` a git.

# --- Obligatorio ---
OPENAI_API_KEY=

# --- Modelos (opcionales) ---
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Base de datos (opcionales; deben coincidir con db/init/001_schema.sql si cambias EMBEDDING_DIM) ---
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag

# --- Ajustes del pipeline RAG (opcionales) ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_CANDIDATES=10
CONTEXT_TOP_K=6
MIN_SIMILARITY=0.30
HYBRID_SEARCH=true
VECTOR_ANCHOR=2
LLM_MAX_CONCURRENCY=4
LLM_TIMEOUT_S=30
